# ---------------------------------------------------------------------------
# TrustECG -- what should NOT go to GitHub
# ---------------------------------------------------------------------------

# The PhysioNet database (18 GB). Users download it themselves; see the README.
data/
*.mat
*.hea

# Virtual environment (4.7 GB) -- rebuilt from requirements.txt
.venv/
venv/
env/

# Python caches
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Model checkpoints. Too large for a normal repo -- attach them to a GitHub
# Release instead, as the README explains. Delete these four lines if you
# decide to commit them anyway (GitHub warns above 50 MB, blocks above 100 MB).
*.pth
*.pt
*.h5
*.ckpt

# Preprocessed arrays -- regenerated by the preprocessing script
X_train.npy
X_val.npy
X_test.npy
*_processed.npy

# Per-run output: figures, reports, analyses
outputs/
xai_report/
_archive_*/

# Scratch
test_case.npy
case1.npy
*.rebuilt
*_BACKUP/
*_BACKUP*/

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# ---------------------------------------------------------------------------
# Deliberately KEPT (small, and needed to reproduce the published numbers):
#   val_probs_*.npy, test_probs_*.npy, y_val.npy, y_test.npy   (~1.5 MB total)
#   ensemble_combiner.json, ensemble_*_results.json
# ---------------------------------------------------------------------------